# ==============================================================================
# Varunya Technologies — Production Environment Configuration (.env.example)
# Target Environment: Ubuntu Server (Docker Compose)
# Note: Copy this file to '.env' and populate with production secrets.
# Do NOT commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Host Binding Configuration
# ------------------------------------------------------------------------------
# In production behind a reverse proxy (e.g. Cloudflare / Nginx / Caddy),
# bind to 127.0.0.1 to avoid exposing the Node container directly to the public web.
HOST_BIND_IP=127.0.0.1
APP_PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Connection string used by Prisma & application container
DATABASE_URL="postgresql://velocity:velocity_secret@postgres:5432/velocity30_db?schema=public"

# Database service credentials (used to initialize the PostgreSQL container)
POSTGRES_USER=velocity
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=velocity30_db

# Host persistent storage path on Ubuntu Server (NAS Mount)
# Leave commented out to use Docker named volume 'varunya_tech_postgres_data'
# For the 1TB NAS drive mount, uncomment the following line:
# VARUNYA_POSTGRES_DATA_PATH=/srv/nas1tb/varunya/postgres_data

# ------------------------------------------------------------------------------
# 3. Redis Cache & Session Configuration
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 4. Ingress & Zero Trust Tunnel (Cloudflare)
# ------------------------------------------------------------------------------
# Provided by Cloudflare Zero Trust dashboard (leave empty if using Nginx/Traefik)
TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 5. Application Security & Canonical Domain
# ------------------------------------------------------------------------------
# Canonical production domain
NEXT_PUBLIC_SITE_URL="https://varunyatech.com"

# NextAuth / JWT secret (generate using: openssl rand -base64 32)
NEXTAUTH_SECRET="generate_32_char_random_base64_secret"
NEXTAUTH_URL="https://varunyatech.com"

# ------------------------------------------------------------------------------
# 6. Optional Third-Party Integrations (Server-Side Secrets)
# ------------------------------------------------------------------------------
# AI Provider Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PINECONE_API_KEY=""

# Email Notification Delivery (Resend / SMTP)
RESEND_API_KEY=""

# Payment Processing (Stripe / Razorpay)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Error Tracking & Telemetry (Sentry / PostHog)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
